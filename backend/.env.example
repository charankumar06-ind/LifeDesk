# Copy to backend/.env (ignored by git) and start uvicorn with:
#   .venv\Scripts\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --env-file .env

# local | mcp
LIFEDESK_PROVIDER_MODE=local

# --- Login -----------------------------------------------------------------
# The app starts locked; the first visit shows a one-time setup screen.
# Set these only to bootstrap an owner account at startup (hashed on first run).
# LIFEDESK_AUTH_USER=owner
# LIFEDESK_AUTH_PASSWORD=choose-a-strong-password
# LIFEDESK_SESSION_DAYS=7
# LIFEDESK_COOKIE_SECURE=0

# stdio | http
LIFEDESK_MCP_TRANSPORT=stdio

# --- Bundled reference server (defaults; no credentials) -------------------
# LIFEDESK_MCP_COMMAND=C:\path\to\backend\.venv\Scripts\python.exe
# LIFEDESK_MCP_ARGS=["-m","mcp_server.server"]
# LIFEDESK_MCP_CWD=D:\CKR\Projects\LifeDesk\backend
# LIFEDESK_MCP_LABEL=LifeDesk reference MCP server

# --- External streamable-HTTP MCP bridge -----------------------------------
# LIFEDESK_MCP_URL=https://your-bridge.example.com/mcp
# LIFEDESK_MCP_HEADERS={"Authorization":"Bearer replace-with-your-token"}

# --- Extra environment for a stdio bridge (credentials live here) ----------
# LIFEDESK_MCP_ENV={"GOOGLE_CLIENT_ID":"...","GOOGLE_CLIENT_SECRET":"...","GOOGLE_REFRESH_TOKEN":"..."}

# local: fall back to SQLite when MCP startup fails; error: fail startup
LIFEDESK_MCP_FALLBACK=local
LIFEDESK_MCP_TIMEOUT=15

# --- Email delivery for the MCP server (real SMTP; never committed) --------
# Gmail: enable 2-Step Verification, create an App Password, and use that here.
# LIFEDESK_SMTP_HOST=smtp.gmail.com
# LIFEDESK_SMTP_PORT=587
# LIFEDESK_SMTP_USER=you@gmail.com
# LIFEDESK_SMTP_PASSWORD=your-16-character-app-password
# LIFEDESK_SMTP_FROM=you@gmail.com
# LIFEDESK_SMTP_STARTTLS=1
# LIFEDESK_SMTP_SSL=0
